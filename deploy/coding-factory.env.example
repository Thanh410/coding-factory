# Copy to ~/.config/coding-factory.env and `chmod 600`.
# Used by the systemd/cron deployment (see deploy/). Keep secrets out of git.

# --- target repository -----------------------------------------------------
FACTORY_REPO=/srv/app
FACTORY_BASE_BRANCH=main
FACTORY_REMOTE=origin

# --- where the factory works ----------------------------------------------
FACTORY_WORK_ROOT=/var/lib/coding-factory

# --- task intake -----------------------------------------------------------
FACTORY_SOURCE=github
FACTORY_GITHUB_REPO=owner/name
FACTORY_TRIGGER_LABEL=factory

# --- agent backend ---------------------------------------------------------
# codex | antigravity | llm
# `llm` is the built-in provider-fallback backend (OpenRouter/Gemini/Ollama).
FACTORY_BACKEND=codex
# FACTORY_ANTIGRAVITY_CMD=antigravity run --prompt-file -

# --- LLM provider chain (only for FACTORY_BACKEND=llm) ---------------------
# Ordered providers; the first configured one is tried, then the next on failure.
# Unconfigured providers (no key) are skipped automatically.
#
# Run at $0 with OpenRouter's free models (tool-capable), then a local fallback:
#   FACTORY_LLM_CHAIN=free,ollama
# The `free` alias expands to the curated $0 list; `free:3` caps it to 3 models.
FACTORY_LLM_CHAIN=openrouter,gemini,ollama
# Pin a model per step, e.g. openrouter:anthropic/claude-3.5-sonnet
# OPENROUTER_MODEL=openai/gpt-4o-mini
# GEMINI_MODEL=gemini-3.5-flash
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# FACTORY_LLM_MAX_STEPS=30
# FACTORY_LLM_MAX_TOKENS=4096

# --- verification ----------------------------------------------------------
# Leave unset to auto-detect, or pin explicit commands:
# FACTORY_CHECKS=ruff check .;python -m pytest -q
FACTORY_MAX_REPAIRS=2

# --- spec stage (architect pass) -------------------------------------------
# A read-only planning pass runs before coding and its plan is handed to the
# coding agent. ON by default; set false to skip it (saves one agent call).
FACTORY_SPEC_STAGE=true

# --- auto-merge (opt-in) ---------------------------------------------------
FACTORY_AUTO_MERGE=false
FACTORY_MERGE_METHOD=squash
FACTORY_CI_TIMEOUT=1800
FACTORY_CI_POLL=20

# --- monitoring (factory monitor) ------------------------------------------
# Poll Sentry + an uptime URL and open `factory` issues for anything new.
# Set at least one source. FACTORY_MONITOR_LABEL must match FACTORY_TRIGGER_LABEL.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_BASE_URL=https://sentry.io
# SENTRY_QUERY=is:unresolved
# SENTRY_STATS_PERIOD=24h
# SENTRY_LIMIT=10
# UPTIME_URL=https://app.example.com/health
# UPTIME_EXPECT_STATUS=200
# UPTIME_TIMEOUT=10
FACTORY_MONITOR_LABEL=factory

# --- secrets (prefer the secret store in production) -----------------------
OPENAI_API_KEY=
GITHUB_TOKEN=
# LLM provider keys (only the ones in your chain are needed):
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# OLLAMA_API_KEY=        # only if your Ollama sits behind a proxy
