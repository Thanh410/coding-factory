# Copy to ~/.config/coding-factory.env and `chmod 600`.
# Used by the systemd/cron deployment (see deploy/). Keep secrets out of git.

# --- target repository -----------------------------------------------------
FACTORY_REPO=/srv/app
FACTORY_BASE_BRANCH=main
FACTORY_REMOTE=origin

# --- where the factory works ----------------------------------------------
FACTORY_WORK_ROOT=/var/lib/coding-factory

# --- task intake -----------------------------------------------------------
FACTORY_SOURCE=github
FACTORY_GITHUB_REPO=owner/name
FACTORY_TRIGGER_LABEL=factory

# --- agent backend ---------------------------------------------------------
FACTORY_BACKEND=codex
# FACTORY_ANTIGRAVITY_CMD=antigravity run --prompt-file -

# --- verification ----------------------------------------------------------
# Leave unset to auto-detect, or pin explicit commands:
# FACTORY_CHECKS=ruff check .;python -m pytest -q
FACTORY_MAX_REPAIRS=2

# --- auto-merge (opt-in) ---------------------------------------------------
FACTORY_AUTO_MERGE=false
FACTORY_MERGE_METHOD=squash
FACTORY_CI_TIMEOUT=1800
FACTORY_CI_POLL=20

# --- secrets (prefer the secret store in production) -----------------------
OPENAI_API_KEY=
GITHUB_TOKEN=
